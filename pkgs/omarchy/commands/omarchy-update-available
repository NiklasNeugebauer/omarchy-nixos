#!/bin/bash

# omarchy:summary=Check whether a system update is available

# Upstream asks pacman. Here the question is whether the flake's inputs have moved, which is
# answered by a lock-file comparison in a throwaway copy — nothing on the system changes.
#
# Exit codes matter: the bar's SystemUpdate widget polls this, so a network failure must not
# read as "up to date". 0 means updates, 1 means none, 2 means the question could not be
# answered.

set -uo pipefail

# shellcheck source=/dev/null
[[ -r /etc/omarchy-nixos.conf ]] && . /etc/omarchy-nixos.conf

flake=${OMARCHY_NIXOS_FLAKE:-/etc/nixos}
[[ -e $flake/flake.lock ]] || exit 2

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

cp "$flake/flake.nix" "$flake/flake.lock" "$work/" 2>/dev/null || exit 2
nix flake update --flake "$work" >/dev/null 2>&1 || exit 2

if cmp -s "$flake/flake.lock" "$work/flake.lock"; then
  exit 1
fi

echo "flake inputs have new revisions available"
